{
  "name": "pip-desktop-buddy",
  "productName": "Pip",
  "version": "1.1.0",
  "description": "Pip - a tiny pixel-art jellybean who lives on your desktop and looks after your work habits",
  "author": "Pip",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test \"test/*.test.js\"",
    "smoke": "node scripts/smoke.js",
    "icons": "node scripts/make-icons.js",
    "sprites": "node tools/gen-sprites.js",
    "predist": "node scripts/make-icons.js",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.pip.desktopbuddy",
    "productName": "Pip",
    "copyright": "Copyright (c) 2026 Pip",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "!**/*.md",
      "!**/.DS_Store"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pip",
      "uninstallDisplayName": "Pip",
      "artifactName": "Pip-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "Pip-Portable-${version}.${ext}"
    }
  }
}
